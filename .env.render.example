# ============ TELEGRAM ============
# Add the control-bot token too; Telegram API_ID/HASH alone are not a bot token.
CONTROL_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
ADMIN_TELEGRAM_ID=
TELEGRAM_SESSION_NAME=po_session
TELEGRAM_STRING_SESSION=
SIGNAL_BOT_USERNAME=@AboodTradingOTCbot
NEW_SIGNAL_BUTTON_TEXT=New signal

# ============ DATABASE (MONGODB) ============
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
DB_NAME=abood_trading_db

# ============ POCKET OPTION - REAL ACCOUNT ============
# Replace ... and uid=0 with your actual captured full auth frame before trading.
PO_SSID_REAL=42["auth",{"session":"...","isDemo":0,"uid":0,"platform":2}]
PO_WS_URL_REAL=wss://api-msk.po.market/socket.io/?EIO=4&transport=websocket
PO_UID_REAL=0

# ============ POCKET OPTION - DEMO ACCOUNT ============
PO_SSID_DEMO=42["auth",{"session":"...","isDemo":1,"uid":0,"platform":2}]
PO_WS_URL_DEMO=wss://demo-api-eu.po.market/socket.io/?EIO=4&transport=websocket
PO_UID_DEMO=0

# ============ TRADING INITIAL DEFAULTS ============
ACCOUNT_TYPE=PRACTICE
ASSET=EURUSD_otc
TRADE_AMOUNT=1
DURATION_SECONDS=5
ENTRY_DELAY_SECONDS=0.8
MARTINGALE_STEPS=4
LOOP_DELAY_SECONDS=0
SIGNAL_TIMEOUT_SECONDS=15
PORT=10000

# ============ RESULT / LIFECYCLE SAFETY ============
RESULT_TIMEOUT_EXTRA=2
BALANCE_SETTLE_SECONDS=1
LOSS_RECHECK_SECONDS=2
CONNECT_TIMEOUT_SECONDS=25
SHUTDOWN_GRACE_SECONDS=20

# Best-effort health heartbeat; not a free-tier uptime guarantee.

# v16: risk mode and profit/loss limits are saved in MongoDB via Telegram.
# No extra Render environment variable is required. Default is TRADITIONAL.

KEEP_ALIVE_SECONDS=300

# Extra grace after expiry/settlement for trades of 60 seconds or more.
LONG_RESULT_GRACE_SECONDS=45
